#!/usr/bin/env bash

shopt -s expand_aliases

source_list=()
export_aliases=()
export_funcs=()
export_vars=()
export_scripts=()
source_exec='source'
interactive=0
login=0
debug_opt=0
payload=""
failure=0

show_help() {
    cat <<EOF
Usage: ${0##*/} [options] [--] [command...]

Generates a base64-encoded remote payload to pass local functions,
environment variables and scripts over SSH. (Bash) (Not safe for secrets)

Options:
  -s, --source <file>   Source a local file (e.g., ~/.bash_aliases) before exporting.
  -a, --alias <name>    Export a specific alias by name.
  -f, --func <name>     Export a specific local function by name.
  -v, --var <name>      Export a specific local environment variable by name.
  -x, --script <file>   Transfer a local script to a remote temp dir, and add to \$PATH.
  -i, --interactive     Force remote bash to spawn an interactive shell.
  -l, --login           Force remote bash to source profile files.
      --debug           Print the decoded payload string for dry-run debugging.
  -h, --help            Display this help message and exit.

Examples:
  # Start an interactive shell pre-loaded with local function and variable
  ssh -t user@host "\$(${0##*/} -f my_func -v LESS -i)"

  # Execute a local function remotely with options and arguments
  ssh -t user@host "\$(${0##*/} -s ~/.bash_aliases -f deploy_app -- deploy_app production)"

  # Use aliases for repeated operations
  alias sshenv-base="${0##*/} --source='\${HOME}/.bash_aliases' --alias={l,ll,la} --func={l-size,field,total,avg,max,min,max-line,min-line,from-iec,to-iec,showargs}"
  ssh -t user@host "\$(sshenv-base -l -i)"
EOF
}

if (( $# == 0 )); then
    show_help
    exit 0
fi

while (( $# > 0 )); do
    case "$1" in
        -h|--help) show_help; exit 0 ;;
        # local sources
        -s=*|--source=*) source_list+=("${1#*=}"); shift ;;
        -s|--source) source_list+=("$2"); shift 2 ;;
        -s?*) source_list+=("${1#-?}"); shift ;;
        # alias
        -a=*|--alias=*) export_aliases+=("${1#*=}"); shift ;;
        -a|--alias) export_aliases+=("$2"); shift 2 ;;
        -a?*) export_aliases+=("${1#-?}"); shift ;;
        # function
        -f=*|--func=*) export_funcs+=("${1#*=}"); shift ;;
        -f|--func) export_funcs+=("$2"); shift 2 ;;
        -f?*) export_funcs+=("${1#-?}"); shift ;;
        # var
        -v=*|--var=*) export_vars+=("${1#*=}"); shift ;;
        -v|--var) export_vars+=("$2"); shift 2 ;;
        -v?*) export_vars+=("${1#-?}"); shift ;;
        # script
        -x=*|--script=*) export_scripts+=("${1#*=}"); shift ;;
        -x|--script) export_scripts+=("$2"); shift 2 ;;
        -x?*) export_scripts+=("${1#-?}"); shift ;;
        # flags
        -i|--interactive) interactive=1; shift ;;
        -l|--login) login=1; shift ;;
        --debug) debug_opt=1; shift ;;
        --) shift; break ;;
        # compounded options segmentation
        -[!-]?*) opt="$1"; shift; set -- "${opt:0:2}" "-${opt:2}" "$@" ;;
        *) break ;;
    esac
done

# bash login
if (( login > 0 )); then
    # https://man7.org/linux/man-pages/man1/bash.1.html#INVOCATION
    payload+="[[ -f /etc/profile ]] && source /etc/profile"$'\n'
    payload+="[[ -f ~/.bash_profile ]] && source ~/.bash_profile || { [[ -f ~/.bash_login ]] && source ~/.bash_login; } || { [[ -f ~/.profile ]] && source ~/.profile; }"$'\n'
    # trap '[[ -f ~/.bash_logout ]] && source ~/.bash_logout;' added later
fi

# bash interactive
if (( interactive > 0 )); then
    # https://man7.org/linux/man-pages/man1/bash.1.html#INVOCATION
    payload+="[[ -f ~/.bashrc ]] && source ~/.bashrc"$'\n'
    source_exec='exec bash --rcfile'
fi

# source list
for src in "${source_list[@]}"; do
    if [[ -r $src ]]; then
        source "$src"
    else
        printf 'Warning: Source file "%s" not found or unreadable.\n' "$src" >&2
        failure=1
    fi
done

# script list
if (( ${#export_scripts[@]} > 0 )); then
    payload+='_remote_tmp=$(mktemp -d /tmp/sshenv.XXXXXX)'$'\n'
    # payload+='trap '\''rm -rf "$_remote_tmp"'\'' EXIT'$'\n' added later
    payload+='export PATH="$_remote_tmp:$PATH"'$'\n'

    for script in "${export_scripts[@]}"; do
        if [[ -r $script ]]; then
            script_name=$(basename -- "$script")
            script_b64=$(base64 -w 0 < "$script")
            payload+="base64 -d << 'EOF_B64' > \"\$_remote_tmp/${script_name}\""$'\n'
            payload+="${script_b64}"$'\n'
            payload+="EOF_B64"$'\n'
            payload+="chmod +x \"\$_remote_tmp/${script_name}\""$'\n'
        else
            printf 'Warning: Script file "%s" not found or unreadable.\n' "$script" >&2
            failure=1
        fi
    done
fi

# trap logic
if (( login > 0 )) || (( ${#export_scripts[@]} > 0 )); then
    trap_code='trap '\'
    # https://man7.org/linux/man-pages/man1/bash.1.html#INVOCATION
    if (( login > 0 )); then
        trap_code+='[[ -f ~/.bash_logout ]] && source ~/.bash_logout;'
    fi
    if (( ${#export_scripts[@]} > 0 )); then
        trap_code+='rm -rf "$_remote_tmp"'
    fi
    trap_code+=\'' EXIT'
    payload+="$trap_code"$'\n'
fi

# alias list
if (( ${#export_aliases[@]} > 0 )); then
    payload+='shopt -s expand_aliases'$'\n'
    for aka in "${export_aliases[@]}"; do
        if aka_def=$(alias "$aka" 2>/dev/null); then
            payload+="$aka_def"$'\n'
        else
            printf 'Warning: Alias "%s" not found locally.\n' "$aka" >&2
            failure=1
        fi
    done
fi

# function list
for func in "${export_funcs[@]}"; do
    if declare -f "$func" >/dev/null 2>&1; then
        payload+="$(declare -f "$func")"$'\n'
        payload+="export -f $func"$'\n'
    else
        printf 'Warning: Function "%s" not found locally.\n' "$func" >&2
        failure=1
    fi
done

# variable list
for var in "${export_vars[@]}"; do
    if [[ -v "$var" ]]; then
        payload+="$(declare -p "$var")"$'\n'
    else
        printf 'Warning: Variable "%s" is unset.\n' "$var" >&2
        failure=1
    fi
done

# caboose command
if (( $# > 0 )); then
    payload+="$*"$'\n'
fi

encoded=$(printf '%s' "$payload" | gzip -cf9 | base64 -w 0)

if (( debug_opt > 0 )); then
    printf '%s\n' "$payload"
    b64encoded=$(printf '%s' "$payload" | base64 -w 0)
    printf 'Original payload size: %s'$'\n' "$(wc -c <<< "$payload" | numfmt --to iec)"
    printf 'Base64 payload size: %s'$'\n' "$(wc -c <<< "$b64encoded" | numfmt --to iec)"
    printf 'Gzip payload size: %s'$'\n' "$(wc -c <<< "$encoded" | numfmt --to iec)"
    exit 0
fi

(( failure > 0 )) && exit 1

printf "%s <(base64 -d <<< %s | gzip -dc)"$'\n' "$source_exec" "$encoded"
