#!/usr/bin/env bash

shopt -s expand_aliases

source_list=()
export_aliases=()
export_funcs=()
export_vars=()
export_scripts=()
export_extras=()
source_exec='source'
interactive=0
login=0
debug_opt=0
tmp_dir=""
payload=""
failure=0

show_help() {
    cat <<EOF
Usage: ${0##*/} [options] [--] [command...]

Generates a base64-encoded remote payload to pass local functions,
environment variables and scripts over SSH. (Bash) (Not safe for secrets)
Stdin and [command...] are encapsulated to be executed at the end.

Options:
  -s, --source <file>   Source a local file (e.g., ~/.bash_aliases) before exporting.
  -a, --alias <name>    Export a specific alias by name.
  -f, --func <name>     Export a specific local function by name.
  -v, --var <name>      Export a specific local environment variable by name.
  -x, --script <file>   Transfer a local script to a remote temp dir, and add to \$PATH.
  -e, --extra <file>    Transfer a local file to a remote temp dir. (COSSE_EXTRA)
  -i, --interactive     Force remote bash to spawn an interactive shell.
  -l, --login           Force remote bash to source profile files.
  -t, --tmp-dir <dir>   Use {dir}/ instead of /tmp/ for default executable directory.
      --debug           Print the decoded payload string for dry-run debugging.
  -h, --help            Display this help message and exit.

Examples:
  # Start an interactive shell pre-loaded with local function and variable
  ssh -t user@host "\$(${0##*/} -f my_func -v LESS -i)"

  # Execute a local function remotely with options and arguments
  ssh -t user@host "\$(${0##*/} -s ~/.bash_aliases -f deploy_app -- deploy_app production)"

  # Use aliases for repeated operations
  alias sshenv-base="${0##*/} --source='\${HOME}/.bash_aliases' --alias={l,ll,la} --func={l-size,field,total,avg,max,min,max-line,min-line,from-iec,to-iec,showargs}"
  ssh -t user@host "\$(sshenv-base -li -- echo 'Home Sweet Home')"
EOF
}

if (( $# == 0 )) && [[ -t 0 ]]; then
    show_help
    exit 0
fi

while (( $# > 0 )); do
    case "$1" in
        -h|--help) show_help; exit 0 ;;
        # local sources
        -s=*|--source=*) source_list+=("${1#*=}"); shift ;;
        -s|--source) source_list+=("$2"); shift 2 || shift ;;
        -s?*) source_list+=("${1:2}"); shift ;;
        # alias
        -a=*|--alias=*) export_aliases+=("${1#*=}"); shift ;;
        -a|--alias) export_aliases+=("$2"); shift 2 || shift ;;
        -a?*) export_aliases+=("${1:2}"); shift ;;
        # function
        -f=*|--func=*) export_funcs+=("${1#*=}"); shift ;;
        -f|--func) export_funcs+=("$2"); shift 2 || shift ;;
        -f?*) export_funcs+=("${1:2}"); shift ;;
        # var
        -v=*|--var=*) export_vars+=("${1#*=}"); shift ;;
        -v|--var) export_vars+=("$2"); shift 2 || shift ;;
        -v?*) export_vars+=("${1:2}"); shift ;;
        # script
        -x=*|--script=*) export_scripts+=("${1#*=}"); shift ;;
        -x|--script) export_scripts+=("$2"); shift 2 || shift ;;
        -x?*) export_scripts+=("${1:2}"); shift ;;
        # extra
        -e=*|--extra=*) export_extras+=("${1#*=}"); shift ;;
        -e|--extra) export_extras+=("$2"); shift 2 || shift ;;
        -e?*) export_extras+=("${1:2}"); shift ;;
        # tmp-dir
        -t=*|--tmp-dir=*) tmp_dir="${1#*=}"; shift ;;
        -t|--tmp-dir) tmp_dir="$2"; shift 2 || shift ;;
        -t?*) tmp_dir="${1:2}"; shift ;;
        # flags
        -i|--interactive) interactive=1; shift ;;
        -l|--login) login=1; shift ;;
        --debug) debug_opt=1; shift ;;
        --) shift; break ;;
        # compounded options segmentation
        -[!-]?*) opt="$1"; shift; set -- "${opt:0:2}" "-${opt:2}" "$@" ;;
        *) break ;;
    esac
done

# bash login
if (( login > 0 )); then
    # https://man7.org/linux/man-pages/man1/bash.1.html#INVOCATION
    payload+="[[ -f /etc/profile ]] && source /etc/profile"$'\n'
    payload+="[[ -f ~/.bash_profile ]] && source ~/.bash_profile || { [[ -f ~/.bash_login ]] && source ~/.bash_login; } || { [[ -f ~/.profile ]] && source ~/.profile; }"$'\n'
    # trap '[[ -f ~/.bash_logout ]] && source ~/.bash_logout;' added later
fi

# bash interactive
if (( interactive > 0 )); then
    # https://man7.org/linux/man-pages/man1/bash.1.html#INVOCATION
    payload+="[[ -f ~/.bashrc ]] && source ~/.bashrc"$'\n'
    source_exec='exec bash --rcfile'
fi

# source list
for src in "${source_list[@]}"; do
    if [[ -r "$src" ]]; then
        source "$src"
    else
        printf 'Warning: Source file "%s" not found or unreadable.\n' "$src" >&2
        failure=1
    fi
done

if (( ${#export_scripts[@]} > 0 )) || (( ${#export_extras[@]} > 0 )); then
    probe_dir() {
        local probe="/tmp/exec_probe.$$.bash"
        local tmp_base=''
        local candidates=()
        local dir target

        [[ -n "$1" ]] && candidates+=("$1")
        candidates+=('/tmp' '/var/tmp' "${HOME:-}/.cache" "${HOME:-}" "$PWD")

        if ! printf '#!/usr/bin/env bash\nexit 0\n' > "$probe" 2>/dev/null; then
            printf 'Warning: could not create probe in /tmp; falling back to /tmp.\n' >&2
            printf '%s' '/tmp'
            return 0
        fi
        chmod +x -- "$probe" 2>/dev/null || true

        for dir in "${candidates[@]}"; do
            dir="${dir%/}"
            if [[ -z "$dir" || ! -d "$dir" ]]; then
                continue
            fi

            target="${dir}/${probe##*/}"
            if [[ "$probe" != "$target" ]]; then
                mv -f -- "$probe" "$target" 2>/dev/null || continue
                probe="$target"
            fi

            if "$probe" >/dev/null 2>&1; then
                tmp_base="$dir"
                break
            fi
        done
        rm -f -- "$probe"

        if [[ -z "$tmp_base" ]]; then
            printf 'Warning: no executable directory found. Scripts left in /tmp.\n' >&2
            tmp_base='/tmp'
        fi

        printf '%s' "$tmp_base"
    }
    payload+="$(declare -f 'probe_dir')"$'\n'
    payload+="export -f probe_dir"$'\n'
    payload+=$(printf 'export COSSE_TMP_BASE=$(probe_dir %q)' "${tmp_dir:-}")$'\n'
fi

# script list
if (( ${#export_scripts[@]} > 0 )); then
    payload+='export COSSE_BIN=$(mktemp -d "${COSSE_TMP_BASE:-/tmp}"/cosse.bin.XXXXXX)'$'\n'
    payload+='[[ -n "$COSSE_BIN" ]] && export PATH="$COSSE_BIN:$PATH"'$'\n'

    for script in "${export_scripts[@]}"; do
        if [[ -r "$script" ]]; then
            script_name=$(basename -- "$script")
            script_b64=$(base64 -w 0 < "$script")
            payload+="base64 -d << 'EOF_B64' > \"\$COSSE_BIN/${script_name}\""$'\n'
            payload+="${script_b64}"$'\n'
            payload+="EOF_B64"$'\n'
            payload+="chmod +x \"\$COSSE_BIN/${script_name}\""$'\n'
        else
            printf 'Warning: Script file "%s" not found or unreadable.\n' "$script" >&2
            failure=1
        fi
    done
fi

# extra file list
if (( ${#export_extras[@]} > 0 )); then
    payload+='export COSSE_EXTRA=$(mktemp -d "${COSSE_TMP_BASE:-/tmp}"/cosse.extra.XXXXXX)'$'\n'

    for file in "${export_extras[@]}"; do
        if [[ -r "$file" ]]; then
            file_name=$(basename -- "$file")
            file_b64=$(base64 -w 0 < "$file")
            payload+="base64 -d << 'EOF_B64' > \"\$COSSE_EXTRA/${file_name}\""$'\n'
            payload+="${file_b64}"$'\n'
            payload+="EOF_B64"$'\n'
        else
            printf 'Warning: File "%s" not found or unreadable.\n' "$file" >&2
            failure=1
        fi
    done
fi

# trap logic
if (( login > 0 )) || (( ${#export_scripts[@]} > 0 )) || (( ${#export_extras[@]} > 0 )); then
    trap_code='trap '\'
    if (( ${#export_scripts[@]} > 0 )); then
        trap_code+='rm -rf "$COSSE_BIN";'
    fi
    if (( ${#export_extras[@]} > 0 )); then
        trap_code+='rm -rf "$COSSE_EXTRA";'
    fi
    # https://man7.org/linux/man-pages/man1/bash.1.html#INVOCATION
    if (( login > 0 )); then
        trap_code+='[[ -f ~/.bash_logout ]] && source ~/.bash_logout;'
    fi
    trap_code+=\'' EXIT'
    payload+="$trap_code"$'\n'
fi

# alias list
if (( ${#export_aliases[@]} > 0 )); then
    payload+='shopt -s expand_aliases'$'\n'
    for aka in "${export_aliases[@]}"; do
        if aka_def=$(alias "$aka" 2>/dev/null); then
            payload+="$aka_def"$'\n'
        else
            printf 'Warning: Alias "%s" not found locally.\n' "$aka" >&2
            failure=1
        fi
    done
fi

# function list
for func in "${export_funcs[@]}"; do
    if declare -f "$func" >/dev/null 2>&1; then
        payload+="$(declare -f "$func")"$'\n'
        payload+="export -f $func"$'\n'
    else
        printf 'Warning: Function "%s" not found locally.\n' "$func" >&2
        failure=1
    fi
done

# variable list
for var in "${export_vars[@]}"; do
    if [[ -v "$var" ]]; then
        payload+="$(declare -p "$var")"$'\n'
    elif [[ -n "$var" ]]; then
        printf 'Warning: Variable "%s" is unset.\n' "$var" >&2
    fi
done

# stdin script
if ! [[ -t 0 ]]; then
    payload+=$(cat)$'\n'
fi

# caboose command
if (( $# > 0 )); then
    payload+="$*"$'\n'
fi

encoded=$(printf '%s' "$payload" | gzip -cf9 | base64 -w 0)

if (( debug_opt > 0 )); then
    printf '%s\n' "$payload"
    b64encoded=$(printf '%s' "$payload" | base64 -w 0)
    printf 'Original payload size: %s'$'\n' "$(wc -c <<< "$payload" | numfmt --to iec)"
    printf 'Base64 payload size: %s'$'\n' "$(wc -c <<< "$b64encoded" | numfmt --to iec)"
    printf 'Gzip payload size: %s'$'\n' "$(wc -c <<< "$encoded" | numfmt --to iec)"
    exit 0
fi

(( failure > 0 )) && exit 1

printf "%s <(base64 -d <<< %s | gzip -dc)"$'\n' "$source_exec" "$encoded"
